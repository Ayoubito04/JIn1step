DATABASE_URL="postgresql://usuario:password@localhost:5432/jin1step_db?schema=public"
PORT=3000
NODE_ENV=development

# Genera los secretos con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=

# Opcional para arrancar el backend; necesario para probar Checkout localmente.
# Usa claves de prueba de Stripe (no pongas claves sk_live aquí).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_ANUAL=
# URL pública/local a la que Stripe devuelve al usuario al terminar Checkout.
APP_URL=http://localhost:5000
